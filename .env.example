# Frontend environment variables — copy to .env and fill in.
# Backend API base URL (where the Express server runs)
VITE_API_URL=http://localhost:5001

# Paystack PUBLIC key (pk_test_... while testing, pk_live_... in production)
# Get it from https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
