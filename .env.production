# Production build env — loaded automatically by `vite build`.
# Overrides the local .env values in the deployed bundle.
VITE_API_URL=https://hotstaples-backend.onrender.com

# Paystack PUBLIC key (pk_test_... while testing, pk_live_... in production).
# Must match the mode of PAYSTACK_SECRET_KEY on the backend.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_44b782bbfdef9388eadff20bba7293f1d50b0782
